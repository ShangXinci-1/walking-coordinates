# Public browser key for 高德地图 Web 端（JS API）.
NEXT_PUBLIC_AMAP_JS_KEY=

# Public URL of the Nginx proxy, including the fixed /_AMapService prefix.
NEXT_PUBLIC_AMAP_SERVICE_HOST=https://map-proxy.example.com/_AMapService

# Server-side/local-only 高德 Web 服务 Key used by the geocoding script.
WC_AMAP_WEB_KEY=
